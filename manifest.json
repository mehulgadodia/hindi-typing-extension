{
  "manifest_version": 3,
  "name": "Hindi Type",
  "version": "1.0.0",
  "description": "Translate English to Hindi, review it, and insert it at your webpage cursor.",
  "permissions": ["storage"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Hindi Type"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle"}]
}
